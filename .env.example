# Copy to .env for local development. Never commit real secrets.

# Service identity
APP_NAME=secure-file-service
ENVIRONMENT=development            # development | test | staging | production
LOG_LEVEL=INFO
LOG_FORMAT=json                    # json | console

# HTTP
HOST=0.0.0.0
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080   # used to build signed URLs; must be https in production
TRUSTED_HOSTS=*                          # comma-separated Host allow-list, e.g. files.example.com
CORS_ORIGINS=                            # empty disables CORS
MAX_REQUEST_BODY_BYTES=1048576           # non-upload requests (1 MiB)
SHUTDOWN_TIMEOUT_SECONDS=20

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/files
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=5000

# Private storage (never mounted as static files)
STORAGE_ROOT=./var/storage
MAX_UPLOAD_BYTES=104857600               # 100 MiB
UPLOAD_CHUNK_BYTES=65536

# Signed links. Format: "keyid:secret,keyid:secret". First entry is active unless
# SIGNING_ACTIVE_KEY_ID is set. Generate a secret with: make secret
SIGNING_KEYS=dev:dev-signing-secret-do-not-use-in-production-0123456789
SIGNING_ACTIVE_KEY_ID=
DEFAULT_LINK_TTL_SECONDS=3600
MAX_LINK_TTL_SECONDS=604800              # 7 days

# Owner authentication. Format: "apikey:userid,apikey:userid"
API_KEYS=dev-key-alice:alice,dev-key-bob:bob

# Observability
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=secure-file-service
OTEL_EXPORTER_OTLP_ENDPOINT=
